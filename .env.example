# 复制为 .env 后填写（.env 已被 .gitignore 忽略，不会提交）。
# 更推荐的做法：在云端环境设置里添加同名变量，环境里已有的值优先于 .env。

# 通义千问（DashScope，OpenAI 兼容模式）
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen3.8-max
# 国际站账号改用：https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4.1-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Claude（可选）
ANTHROPIC_API_KEY=
