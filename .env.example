# 复制为 .env 后填写（.env 已被 .gitignore 忽略，不会提交）。
# 更推荐的做法：在云端环境设置里添加同名变量，环境里已有的值优先于 .env。

# 通义千问：千问 AI 平台（platform.qianwenai.com）按量付费 key，Anthropic 兼容接口
QWEN_API_KEY=
QWEN_MODEL=qwen3.8-max
QWEN_BASE_URL=https://maas.qianwenaiapi.com/apps/anthropic
# 如果改用平台的 OpenAI 兼容地址：QWEN_API_STYLE=openai，并把 QWEN_BASE_URL 换成那个地址

# DeepSeek（OpenAI 兼容接口）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Claude（可选）
ANTHROPIC_API_KEY=
